<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<!-- Define el origen oficial de NuGet -->
	<packageSources>
		<clear />
		<add key="nuget.org" value="https://nuget.org" />
	</packageSources>

	<!-- Autoriza a NuGet a descargar los paquetes requeridos -->
	<packageSourceMapping>
		<packageSource key="nuget.org">
			<package pattern="*" />
			<package pattern="Microsoft.*" />
			<package pattern="microsoft.dotnet-scaffold" />
		</packageSource>
	</packageSourceMapping>
</configuration>
